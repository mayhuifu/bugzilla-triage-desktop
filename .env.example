# Bugzilla connection (server-side only — not exposed to the browser).
# If unset, the app uses mock data so the demo runs without a backend.
BUGZILLA_URL=https://ticketing.internal.umsemi.com
BUGZILLA_API_KEY=your_api_key_here

# Set to "true" if your Bugzilla uses a self-signed certificate (common
# for internal deployments). Adds a stderr warning on startup.
BUGZILLA_INSECURE=true

# Optional — used as the fallback "current user" when /whoami isn't available
BUGZILLA_LOGIN=your.email@umsemi.com
