# ── Required ──────────────────────────────────────────────────────────────
# Session + at-rest encryption key for user profiles. Generate once:
#   openssl rand -hex 32
# KEEP IT STABLE: changing it orphans existing profiles (they can no longer
# be decrypted — users would have to re-run /setup).
APP_SECRET=

# The company Bugzilla every user shares (each user acts with their OWN key).
BUGZILLA_URL=https://ticketing.internal.umsemi.com
# Self-signed/internal TLS on Bugzilla → keep true.
BUGZILLA_INSECURE=true

# ── Company LLM (what "Use company AI" in /setup resolves to) ─────────────
COMPANY_LLM_PROVIDER=openai-compatible
COMPANY_LLM_BASE_URL=https://api.deepseek.com
COMPANY_LLM_API_KEY=
COMPANY_LLM_MODEL=deepseek-chat

# ── Optional knobs (defaults shown; uncomment to change) ──────────────────
# Per-user budgets on LLM-spending routes (per minute):
#RATE_TRIAGE_PER_MIN=6
#RATE_RERANK_PER_MIN=20
# Audit trail of Bugzilla writes (JSONL):
#AUDIT_LOG=/data/audit.log
# Internal mirror for the 3GPP corpus artifact (default: GitHub Releases):
#CORPUS_MANIFEST_URL=
