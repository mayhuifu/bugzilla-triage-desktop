node_modules/
.next/
tsconfig.tsbuildinfo
# electron-builder output — installers can be 100+ MB each, shipped via
# GitHub Releases (see .github/workflows/release.yml), not via git.
dist/
.env
.env.local
.env*.local
.DS_Store
*.log
__pycache__/
*.pyc

# Never commit a local copy of .mcp.json with credentials
.mcp.json

# Bundled bge embedding model (staged by scripts/fetch-embed-model.mjs before
# `dist:*`). ~22 MB of binary ONNX + tokenizer — shipped inside the installer,
# not via git. Keep the dir (.gitkeep) so electron-builder's `from: "models"`
# resolves even when the model hasn't been staged yet.
/models/*
!/models/.gitkeep
