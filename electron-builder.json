{
  "appId": "com.umsemi.bugzilla-triage-desktop",
  "productName": "Bugzilla AI Triage",
  "copyright": "Copyright © 2026",

  "directories": {
    "output": "dist"
  },
  "compression": "maximum",
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ],
  "_npmRebuildHistory": "v0.1.9 turned this off because the older better-sqlite3 + Electron 42 V8 13 combo failed to compile on macOS ('Value' declared here). The trade-off was that better-sqlite3's Node-ABI prebuild (NODE_MODULE_VERSION 115 = Node 20) shipped unchanged — at runtime Electron 42 (NODE_MODULE_VERSION 146) couldn't load it (ERR_DLOPEN_FAILED), which produced silent engineLoaded=false on every installer from v0.1.10..v0.1.22. v0.1.23 turns it back on; @electron/rebuild fetches the Electron-targeted prebuild (or recompiles) so the .node binary matches the runtime ABI. fail-fast:false in CI guarantees per-platform regressions don't sink the others.",
  "npmRebuild": true,

  "files": [
    "electron/**/*",
    "package.json"
  ],

  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "app/.next/standalone",
      "filter": ["**/*", "!node_modules"]
    },
    {
      "from": ".next/standalone/node_modules",
      "to": "app/.next/standalone/node_modules",
      "filter": ["**/*"]
    },
    {
      "from": ".next/static",
      "to": "app/.next/standalone/.next/static",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/better-sqlite3",
      "to": "app/.next/standalone/node_modules/better-sqlite3",
      "filter": ["**/*", "!build/Release/obj.target/**", "!build/Release/.deps/**", "!deps/**", "!src/**", "!**/*.tar.gz"]
    },
    {
      "from": "node_modules/bindings",
      "to": "app/.next/standalone/node_modules/bindings",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/file-uri-to-path",
      "to": "app/.next/standalone/node_modules/file-uri-to-path",
      "filter": ["**/*"]
    },
    {
      "from": "node_modules/sqlite-vec",
      "to": "app/.next/standalone/node_modules/sqlite-vec",
      "filter": ["**/*"]
    }
  ],

  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.png",
    "artifactName": "Bugzilla-AI-Triage-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "node_modules/sqlite-vec-windows-x64",
        "to": "app/.next/standalone/node_modules/sqlite-vec-windows-x64",
        "filter": ["**/*"]
      }
    ]
  },

  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Bugzilla AI Triage"
  },

  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      }
    ],
    "icon": "build/icon.png",
    "category": "public.app-category.developer-tools",
    "artifactName": "Bugzilla-AI-Triage-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "node_modules/sqlite-vec-darwin-arm64",
        "to": "app/.next/standalone/node_modules/sqlite-vec-darwin-arm64",
        "filter": ["**/*"]
      }
    ]
  },

  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.png",
    "category": "Development",
    "extraResources": [
      {
        "from": "node_modules/sqlite-vec-linux-x64",
        "to": "app/.next/standalone/node_modules/sqlite-vec-linux-x64",
        "filter": ["**/*"]
      }
    ]
  }
}
